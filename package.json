{
  "name": "priv-spaca",
  "version": "1.0.0",
  "description": "PRIV SPACA - Secure private group chat and social community application",
  "type": "module",
  "main": "api/cf-worker.js",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs && npm run build:auth",
    "check": "node scripts/check.mjs",
    "test:omni": "node scripts/omni-engine.test.mjs",
    "test:v169": "node --import ./scripts/node-register-npm.mjs scripts/v169-performance.test.mjs",
    "test:v170": "node --import ./scripts/node-register-npm.mjs scripts/test-v170.mjs",
    "test:browser": "playwright test scripts/auth-browser-v170.spec.mjs --reporter=line",
    "test:security": "node scripts/security-suite.mjs",
    "deploy": "node scripts/preflight-deploy.mjs && wrangler pages deploy . --project-name=priv-spaca --branch=main",
    "build:auth": "esbuild react-auth/main.jsx --bundle --format=iife --minify --target=es2019 --outfile=auth.react.min.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "bcryptjs": "^3.0.3",
    "heic2any": "^0.0.4",
    "hono": "^4.13.7",
    "js-base64": "^3.7.7",
    "pg": "^8.11.3",
    "promise-limit": "^2.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "clean-css-cli": "^5.6.3",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "terser": "^5.48.0",
    "wrangler": "^4.129.0"
  },
  "license": "MIT"
}
