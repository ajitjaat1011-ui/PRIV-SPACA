{
  "name": "priv-spaca",
  "version": "1.0.0",
  "description": "PRIV SPACA - Secure private group chat and social community application",
  "type": "module",
  "main": "api/cf-worker.js",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs && npm run build:auth",
    "check": "node scripts/check.mjs",
    "test:omni": "node scripts/omni-engine.test.mjs",
    "deploy": "wrangler pages deploy . --project-name=priv-spaca --branch=main --commit-dirty=true",
    "build:auth": "esbuild react-auth/main.jsx --bundle --format=iife --minify --target=es2019 --outfile=auth.react.min.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "hono": "^4.12.27",
    "js-base64": "^3.7.7",
    "promise-limit": "^2.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "clean-css-cli": "^5.6.3",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "terser": "^5.48.0",
    "wrangler": "^4.86.0"
  },
  "license": "MIT"
}